<section class="sec" id="shop" data-scene="3">
  <div class="wrap">
    <div class="panel-head rv">
      {%- if section.settings.kicker != blank -%}
      <span class="kicker">{{ section.settings.kicker }}</span>
      {%- endif -%}
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      <div class="rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
    </div>

    <div class="shelf">
      {%- assign product_limit = section.settings.product_count -%}
      {%- for product in section.settings.collection.products limit: product_limit -%}
      <article class="glass card rv{% if forloop.index0 == 1 %} rv-d1{% elsif forloop.index0 == 2 %} rv-d2{% elsif forloop.index0 == 3 %} rv-d3{% endif %}">
        <a href="{{ product.url }}" class="shot">
          {%- if product.available == false -%}
          <span class="pill">Sold out</span>
          {%- elsif product.metafields.custom.badge_label != blank -%}
          <span class="pill">{{ product.metafields.custom.badge_label }}</span>
          {%- endif -%}

          {%- if product.featured_image != blank -%}
          <span class="pimg" role="img" aria-label="{{ product.featured_image.alt | default: product.title }}" style="background-image:url('{{ product.featured_image | image_url: width: 400 }}');background-size:cover;background-position:center;display:block;width:100%;height:100%;border-radius:inherit"></span>
          {%- else -%}
          <span class="pimg" role="img" aria-label="{{ product.title }}" style="display:flex;align-items:center;justify-content:center;background:rgba(236,230,247,.08);width:100%;height:100%;border-radius:inherit;font-size:11px;color:var(--paper-3)">No image</span>
          {%- endif -%}
        </a>
        <h4><a href="{{ product.url }}">{{ product.title }}</a></h4>

        {%- if product.metafields.reviews.rating != blank -%}
        <div class="rate"><b>★ {{ product.metafields.reviews.rating.value }}</b> · {{ product.metafields.reviews.rating_count }} reviews</div>
        {%- endif -%}

        <div class="pr">
          <strong>{{ product.price | money }}</strong>
          {%- if product.compare_at_price > product.price -%}
          <s>{{ product.compare_at_price | money }}</s>
          {%- assign discount = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price -%}
          <em>{{ discount | round }}% off</em>
          {%- endif -%}
        </div>

        {%- form 'product', product -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <button type="submit" class="btn btn-ghost btn-sm" {% if product.available == false %}disabled{% endif %}>
            {%- if product.available == false -%}Sold out{%- else -%}Add to cart{%- endif -%}
          </button>
        {%- endform -%}
      </article>
      {%- else -%}
        <p class="body-s">Select a collection in the section settings to show products here.</p>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop grid",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker text", "default": "Bestsellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by 30,000 homes" },
    { "type": "collection", "id": "collection", "label": "Collection to display" },
    { "type": "range", "id": "product_count", "label": "Number of products", "min": 2, "max": 12, "step": 1, "default": 8 }
  ],
  "presets": [
    { "name": "Shop grid" }
  ]
}
{% endschema %}
