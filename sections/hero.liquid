<section class="hero" data-scene="1">
  <div class="hero-grid">

    {%- if section.blocks.size > 0 -%}
    <div class="badges glass-2" aria-label="Product promises">
      {%- for block in section.blocks -%}
        {%- if block.type == 'badge' -%}
        <div class="badge" {{ block.shopify_attributes }}>
          <span class="bi">{{ block.settings.icon }}</span>
          <span>{{ block.settings.line1 }}<br>{{ block.settings.line2 }}</span>
        </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- endif -%}

    <div class="hero-copy">
      <h1 class="d1 rv in">
        {{ section.settings.heading_line1 }}<br>
        {{ section.settings.heading_line2 }}<br>
        <span class="lime">{{ section.settings.heading_highlight }}</span>
      </h1>
      <div class="rule rv rv-d1">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
      <div class="lede rv rv-d2">{{ section.settings.lede }}</div>
      <div class="hero-cta rv rv-d3">
        {%- if section.settings.cta1_link != blank -%}
        <a class="btn btn-primary" href="{{ section.settings.cta1_link }}">{{ section.settings.cta1_label }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
        </a>
        {%- endif -%}
        {%- if section.settings.cta2_link != blank -%}
        <a class="btn btn-ghost" href="{{ section.settings.cta2_link }}">{{ section.settings.cta2_label }}</a>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
      <div class="badgestrip rv rv-d4">
        {%- for block in section.blocks -%}
          {%- if block.type == 'badge' -%}
          <div class="glass-2" {{ block.shopify_attributes }}>
            {{ block.settings.icon }}
            {{ block.settings.line1 }} {{ block.settings.line2 }}
          </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- endif -%}
    </div>

    <div class="hero-prod" id="heroProd">
      <div class="hstage" id="hstage">
        {%- assign slide_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'stage_slide' -%}
            {%- assign slide_index = slide_index | plus: 1 -%}
            <div class="hslide hs{{ slide_index }}{% if slide_index == 1 %} on{% endif %}" data-n="{{ slide_index }}" {{ block.shopify_attributes }}>
              {%- for p in (1..3) -%}
                {%- assign prod_key = 'product_' | append: p -%}
                {%- assign product = block.settings[prod_key] -%}
                {%- if product != blank -%}
                <span class="hp d{{ p }}" style="background-image:url('{{ product.featured_image | image_url: width: 400 }}')" role="img" aria-label="{{ product.featured_image.alt | default: product.title }}"></span>
                {%- endif -%}
              {%- endfor -%}

              {%- assign main_product = block.settings.product_1 -%}
              {%- if main_product != blank -%}
              <div class="glass-2 ptag">
                <span class="lbl">{{ block.settings.label }}</span>
                <span class="val">
                  <strong>{{ main_product.price | money }}</strong>
                  {%- if main_product.compare_at_price > main_product.price -%}
                  <s>{{ main_product.compare_at_price | money }}</s>
                  {%- endif -%}
                </span>
                {%- if main_product.compare_at_price > main_product.price -%}
                  {%- assign discount = main_product.compare_at_price | minus: main_product.price | times: 100.0 | divided_by: main_product.compare_at_price -%}
                <span class="cut">{{ discount | round }}% off</span>
                {%- endif -%}
              </div>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <div class="hdots" id="hdots">
        {%- for block in section.blocks -%}
          {%- if block.type == 'stage_slide' -%}
        <button type="button" aria-label="Show {{ forloop.index }} product{% if forloop.index > 1 %}s{% endif %}"></button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "heading_line1", "label": "Heading line 1", "default": "Clean" },
    { "type": "text", "id": "heading_line2", "label": "Heading line 2", "default": "That" },
    { "type": "text", "id": "heading_highlight", "label": "Heading highlight word", "default": "Lasts" },
    { "type": "richtext", "id": "lede", "label": "Subheading text", "default": "<p>Homecare that works on the toughest grime, made from plants.</p>" },
    { "type": "text", "id": "cta1_label", "label": "Primary button label", "default": "Shop now" },
    { "type": "url", "id": "cta1_link", "label": "Primary button link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary button label", "default": "How it works" },
    { "type": "url", "id": "cta2_link", "label": "Secondary button link" }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (svg code)" },
        { "type": "text", "id": "line1", "label": "Line 1" },
        { "type": "text", "id": "line2", "label": "Line 2" }
      ]
    },
    {
      "type": "stage_slide",
      "name": "Product stage slide",
      "settings": [
        { "type": "text", "id": "label", "label": "Slide label", "default": "Single bottle" },
        { "type": "product", "id": "product_1", "label": "Product 1" },
        { "type": "product", "id": "product_2", "label": "Product 2" },
        { "type": "product", "id": "product_3", "label": "Product 3" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "badge" }, { "type": "badge" }, { "type": "badge" },
        { "type": "stage_slide" }, { "type": "stage_slide" }, { "type": "stage_slide" }
      ]
    }
  ]
}
{% endschema %}
